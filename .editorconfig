# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 120

[*.cs]
indent_style = space
indent_size = 4

[*.{csproj,slnx}]
indent_style = space
indent_size = 2

[*.{gd,gdshader}]
indent_style = tab
indent_size = 4

[*.json]
indent_style = space
indent_size = 2

[*.sln]
indent_style = tab
indent_size = 4
