[sub_resource type="Shader" id="Shader_eepe1"]
code = "shader_type canvas_item;

void fragment() {
	float dist = length(UV - vec2(1.));
	float water = length(UV - vec2(.7)) / 2.;
	vec3 color = mix(vec3(1., .85, 0.), vec3(1., .2, 0.), vec3(smoothstep(0., 1., water)));
	COLOR = vec4(color, smoothstep(1., .85, dist));
}
"

