{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Game",
      "type": "coreclr",
      "request": "launch",
      "program": "${config:godotTools.editorPath.godot4}",
      "preLaunchTask": "build",
      "args": [
        "--path",
        "${workspaceRoot}/src/SpaceCapture/"
      ],
      "cwd": "${workspaceFolder}/src/SpaceCapture/",
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": "Server",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/src/SpaceCapture.Server/SpaceCapture.Server.csproj"
    }
  ],
  "compounds": [
    {
      "name": "Game + Server",
      "configurations": [
        "Game",
        "Server"
      ]
    }
  ]
}